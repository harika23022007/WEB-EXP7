<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Working with jQuery</title>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eaf2f8;
            text-align: center;
            margin: 0;
        }

        h1 {
            background: #174a7e;
            color: white;
            padding: 18px;
        }

        .box {
            background: white;
            width: 85%;
            max-width: 650px;
            margin: 20px auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #aaa;
        }

        input, select {
            padding: 8px;
            margin: 6px;
            width: 180px;
        }

        button {
            background: #174a7e;
            color: white;
            border: none;
            padding: 10px 18px;
            margin: 8px;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background: #2879bd;
        }

        .result {
            color: green;
            font-weight: bold;
        }

        #car {
            position: relative;
            width: 300px;
            height: 130px;
            margin: 20px auto;
        }

        #body {
            position: absolute;
            width: 260px;
            height: 55px;
            background: red;
            left: 20px;
            top: 40px;
            border-radius: 45px 55px 12px 12px;
        }

        #roof {
            position: absolute;
            width: 140px;
            height: 45px;
            background: red;
            left: 80px;
            top: 5px;
            border-radius: 60px 60px 0 0;
        }

        .glass {
            position: absolute;
            background: lightblue;
            width: 55px;
            height: 35px;
            top: 10px;
            left: 120px;
            border-radius: 20px 20px 0 0;
        }

        .wheel {
            position: absolute;
            width: 40px;
            height: 40px;
            background: black;
            border-radius: 50%;
            top: 80px;
            transition: width 0.3s, height 0.3s;
        }

        #wheel1 { left: 55px; }
        #wheel2 { right: 55px; }

        .tint {
            background: #222;
        }
    </style>
</head>

<body>

<h1>Working with jQuery</h1>

<div class="box">
    <h2>1. Budget Calculator</h2>

    <p>Enter Total Amount:</p>
    <input type="number" id="amount" placeholder="Enter amount">

    <h3>Enter Percentage Values</h3>

    <input type="number" id="rent" value="30"><br>

    <input type="number" id="accessories" value="20"><br>

    <input type="number" id="emergency" value="20"><br>

    <input type="number" id="saving" value="30"><br>

    <button id="evaluate">Evaluate My Money</button>

    <div id="budgetResult" class="result"></div>
</div>


<div class="box">
    <h2>2. Cake Order Calculator</h2>

    <p>Select Cake Type:</p>
    <select id="cake">
        <option value="500">Chocolate Cake - Rs.500</option>
        <option value="600">Vanilla Cake - Rs.600</option>
        <option value="750">Black Forest - Rs.750</option>
        <option value="900">Red Velvet - Rs.900</option>
    </select>

    <p>Quantity:</p>
    <input type="number" id="quantity" value="1" min="1">

    <p>Extra Decoration:</p>
    <select id="decoration">
        <option value="0">No Decoration - Rs.0</option>
        <option value="100">Simple - Rs.100</option>
        <option value="200">Special - Rs.200</option>
    </select>

    <br>
    <button id="calculate">Calculate Order</button>

    <h3 id="cakeResult" class="result"></h3>
</div>


<div class="box">
    <h2>3. Car Body Workshop</h2>

    <div id="car">
        <div id="roof"></div>
        <div class="glass"></div>
        <div id="body"></div>
        <div class="wheel" id="wheel1"></div>
        <div class="wheel" id="wheel2"></div>
    </div>

    <p>Change Car Colour:</p>
    <button class="color" data-color="red">Red</button>
    <button class="color" data-color="blue">Blue</button>
    <button class="color" data-color="green">Green</button>
    <button class="color" data-color="black">Black</button>

    <p>Change Glass Tint:</p>
    <button id="tint">Change Tint</button>

    <p>Change Tyre Size:</p>
    <button id="small">Small Tyres</button>
    <button id="large">Large Tyres</button>
</div>


<script>
$(document).ready(function() {

    $("#evaluate").click(function() {

        let amount = Number($("#amount").val());

        let rent = Number($("#rent").val());
        let accessories = Number($("#accessories").val());
        let emergency = Number($("#emergency").val());
        let saving = Number($("#saving").val());

        let total = rent + accessories + emergency + saving;

        if ($("#amount").val() === "" || amount <= 0) {
            alert("Please enter a valid amount!");
            return;
        }

        if ([rent, accessories, emergency, saving].some(
            p => p < 0 || p > 100
        )) {
            alert("Percentage values must be between 0 and 100!");
            return;
        }

        if (total !== 100) {
            alert("Total percentage must be exactly 100%!");
            return;
        }

        $("#budgetResult").html(
            "<p>Room Rent: Rs." + (amount * rent / 100) +
            "</p><p>Accessories: Rs." + (amount * accessories / 100) +
            "</p><p>Emergency: Rs." + (amount * emergency / 100) +
            "</p><p>Savings: Rs." + (amount * saving / 100) + "</p>"
        );
    });


    $("#calculate").click(function() {

        let price = Number($("#cake").val());
        let quantity = Number($("#quantity").val());
        let decoration = Number($("#decoration").val());

        if ($("#quantity").val() === "" ||
            !Number.isInteger(quantity) || quantity < 1) {
            alert("Please enter a valid quantity!");
            return;
        }

        let total = (price * quantity) + decoration;

        $("#cakeResult").html(
            "Cake Price: Rs." + price +
            "<br>Quantity: " + quantity +
            "<br>Decoration: Rs." + decoration +
            "<br>Total Amount: Rs." + total
        );
    });

    $(".color").click(function() {

        let selectedColor = $(this).data("color");

        $("#body, #roof").css("background-color", selectedColor);
    });


    $("#tint").click(function() {
        $(".glass").toggleClass("tint");
    });


    $("#small").click(function() {
        $(".wheel").css({
            "width": "30px",
            "height": "30px"
        });
    });

    $("#large").click(function() {
        $(".wheel").css({
            "width": "50px",
            "height": "50px"
        });
    });

});
</script>

</body>
</html>




